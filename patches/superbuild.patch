index 0000000000..cbeb16c754
--- /dev/null
+++ b/.github/workflows/macos-superbuild.yml
@@ -0,0 +1,120 @@
+name: macos-superbuild
+
+on:
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: Release tag to label the build
+        required: true
+        default: v28
+
+permissions:
+  contents: read
+
+jobs:
+  macos-arm64:
+    name: macOS arm64
+    runs-on: macos-15
+    steps:
+      - name: Check out source
+        uses: actions/checkout@v4
+
+      - name: Install macOS dependencies
+        shell: bash
+        env:
+          HOMEBREW_NO_INSTALL_CLEANUP: 1
+          HOMEBREW_NO_AUTO_UPDATE: 1
+        run: |
+          brew install autoconf automake boost ffmpeg fmt glslang hidapi libtool libusb lz4 ninja \
+            nlohmann-json openssl pkg-config qt@6 sdl3 speexdsp zlib zstd cmake catch2 molten-vk \
+            vulkan-loader spirv-tools vulkan-utility-libraries ccache
+
+      - name: Configure
+        shell: bash
+        run: |
+          set -euo pipefail
+          cmake -S . -B build/release -G Ninja \
+            -DCMAKE_BUILD_TYPE=Release \
+            -DBUILD_TESTING=OFF \
+            -DYUZU_TESTS=OFF \
+            -DYUZU_CMD=ON \
+            -DYUZU_ROOM=OFF \
+            -DYUZU_ROOM_STANDALONE=OFF \
+            -DYUZU_USE_BUNDLED_QT=OFF \
+            "-DCMAKE_PREFIX_PATH=$(brew --prefix qt@6);$(brew --prefix zlib)" \
+            "-DOPENSSL_ROOT_DIR=$(brew --prefix openssl@3)" \
+            -DVulkanHeaders_FORCE_BUNDLED=ON \
+            -DVulkanUtilityLibraries_FORCE_BUNDLED=ON \
+            -DENABLE_UPDATE_CHECKER=ON \
+            -DLICHII_BUILD_TAG=${{ inputs.tag }} \
+            -DLICHII_BUILD_PLATFORM=macos-arm64 \
+            -DUSE_DISCORD_PRESENCE=OFF \
+            -DUSE_CCACHE=ON
+
+      - name: Build
+        shell: bash
+        run: cmake --build build/release --target yuzu yuzu-cmd --parallel 4
+
+      - name: Package macOS app
+        shell: bash
+        run: |
+          set -euo pipefail
+          app=build/release/bin/lichii.app
+          test -x "$app/Contents/MacOS/lichii"
+          test -x build/release/bin/eden-cli
+          cp build/release/bin/eden-cli "$app/Contents/MacOS/eden-cli"
+          cp dist/nx2_switches.txt "$app/Contents/Resources/nx2_switches.txt"
+          cp MCP-DEBUG.md "$app/Contents/Resources/MCP-DEBUG.md"
+          mkdir -p "$app/Contents/Resources/tools/nx2" "$app/Contents/Resources/docs/nx2"
+          cp tools/nx2/debug_mcp.py tools/nx2/test_debug_mcp.py "$app/Contents/Resources/tools/nx2/"
+          cp docs/nx2/debug-mcp.md "$app/Contents/Resources/docs/nx2/"
+          "$(brew --prefix qt@6)/bin/macdeployqt" "$app" \
+            -executable="$app/Contents/MacOS/eden-cli" -libpath="$(brew --prefix)/lib" \
+            -always-overwrite -verbose=1
+          rm -f "$app/Contents/PlugIns/platforminputcontexts/libqtvirtualkeyboardplugin.dylib"
+          binaries=$(find "$app/Contents" -type f \( -perm -u+x -o -name '*.dylib' \) \
+            -exec sh -c 'file -b "$1" | grep -q Mach-O' _ {} \; -print)
+          for binary in $binaries; do
+            otool -l "$binary" | awk '/cmd LC_RPATH/ {getline; getline; print $2}' |
+              { grep -E '^/(opt/homebrew|usr/local)/' || true; } | while read -r rpath; do
+                install_name_tool -delete_rpath "$rpath" "$binary" 2> /dev/null
+              done
+          done
+          for program in lichii eden-cli; do
+            install_name_tool -add_rpath @executable_path/../Frameworks \
+              "$app/Contents/MacOS/$program" 2> /dev/null
+          done
+          leaks=$(for binary in $binaries; do
+            otool -L "$binary" | grep -E '^\s+/(opt/homebrew|usr/local)/'
+            otool -l "$binary" | awk '/cmd LC_RPATH/ {getline; getline; print $2}' |
+              grep -E '^/(opt/homebrew|usr/local)/'
+          done || true)
+          if [ -n "$leaks" ]; then
+            echo "References still pointing outside the bundle:"
+            echo "$leaks" | sort -u
+            exit 1
+          fi
+          codesign --force --deep --sign - "$app"
+          if [ -f dist/eglantine.entitlements ]; then
+            codesign --force --sign - --entitlements dist/eglantine.entitlements \
+              "$app/Contents/MacOS/eden-cli"
+            codesign --force --sign - --entitlements dist/eglantine.entitlements "$app"
+          fi
+          codesign --verify --deep --strict "$app"
+          ditto -c -k --keepParent "$app" "Lichii-${{ inputs.tag }}-macos-arm64.zip"
+          dmgdir=$(mktemp -d)
+          ditto "$app" "$dmgdir/lichii.app"
+          ln -s /Applications "$dmgdir/Applications"
+          hdiutil create -volname "Lichii" -srcfolder "$dmgdir" -ov -format UDZO \
+            "Lichii-${{ inputs.tag }}-macos-arm64.dmg"
+          ls -la "Lichii-${{ inputs.tag }}-macos-arm64.zip" "Lichii-${{ inputs.tag }}-macos-arm64.dmg"
+
+      - name: Upload macOS binaries
+        uses: actions/upload-artifact@v7
+        with:
+          name: Lichii-${{ inputs.tag }}-macos-arm64
+          path: |
+            Lichii-${{ inputs.tag }}-macos-arm64.zip
+            Lichii-${{ inputs.tag }}-macos-arm64.dmg
+          if-no-files-found: error
+          compression-level: 0
